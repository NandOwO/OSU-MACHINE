{
  "name": "poipiu",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "POIPIU - maquina arcade de ritmo (osu!standard)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "e2e": "node tools/e2e-smoke.mjs",
    "electron": "vite build && electron electron/main.mjs",
    "electron:dev": "electron electron/main.mjs --dev --url=http://localhost:5173",
    "e2e:electron": "node tools/e2e-electron.mjs",
    "package:win": "vite build && electron-builder --win nsis zip --x64",
    "package:win:portable": "vite build && electron-builder --win zip --x64 -c.win.signAndEditExecutable=false"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "fflate": "0.8.2",
    "lzma": "2.3.2",
    "playwright-core": "^1.49.1",
    "tsx": "^4.19.2",
    "typescript": "5.6.3",
    "vite": "^5.4.11",
    "vitest": "2.1.8"
  },
  "main": "electron/main.mjs",
  "author": "POIPIU",
  "homepage": "https://github.com/NandOwO/OSU-MACHINE",
  "build": {
    "appId": "pe.poipiu.arcade",
    "productName": "POIPIU",
    "copyright": "POIPIU",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.png",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "POIPIU-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "POIPIU",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "POIPIU-Setup-${version}.${ext}"
    }
  }
}
